<Window x:Class="Versioner.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:lottie="clr-namespace:LottieSharp.WPF;assembly=LottieSharp"
        xmlns:m3="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:vm="clr-namespace:Versioner.ViewModels"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        Background="{DynamicResource MaterialDesignPaper}"
        FontFamily="{m3:MaterialDesignFont}"
        TextOptions.TextRenderingMode="Auto"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        AllowDrop="True"
        PreviewDragOver="Window_OnPreviewDragOver"
        PreviewDrop="Window_OnDrop"
        WindowStartupLocation="CenterScreen"
        Height="720"
        Width="1040"
        MinHeight="640"
        MinWidth="1040">
    <Window.Resources>
        <Style x:Key="PillButton" TargetType="Button" BasedOn="{StaticResource MaterialDesignRaisedButton}">
            <Setter Property="Height" Value="36" />
            <Setter Property="MinWidth" Value="76" />
            <Setter Property="Padding" Value="18,0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="m3:ButtonAssist.CornerRadius" Value="18" />
        </Style>
        <Style x:Key="PillButtonQuiet" TargetType="Button" BasedOn="{StaticResource PillButton}">
            <Setter Property="Background" Value="#E8DEF8" />
            <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.Primary}" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style x:Key="PillButtonDanger" TargetType="Button" BasedOn="{StaticResource PillButton}">
            <Setter Property="Background" Value="{DynamicResource MaterialDesign.Brush.ValidationError}" />
            <Setter Property="BorderBrush" Value="{DynamicResource MaterialDesign.Brush.ValidationError}" />
            <Setter Property="Foreground" Value="White" />
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
        <Style x:Key="FieldHelp" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Opacity" Value="0.6" />
            <Setter Property="Margin" Value="0,6,0,0" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="FieldBox" TargetType="TextBox" BasedOn="{StaticResource MaterialDesignFilledTextBox}">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="m3:HintAssist.IsFloating" Value="False" />
            <EventSetter Event="PreviewMouseLeftButtonDown" Handler="FieldBox_OnPreviewMouseLeftButtonDown" />
            <EventSetter Event="PreviewMouseLeftButtonUp" Handler="FieldBox_OnPreviewMouseLeftButtonUp" />
        </Style>
        <Style x:Key="FieldGroup" TargetType="StackPanel">
            <Setter Property="Margin" Value="0,0,0,20" />
        </Style>

        <Style x:Key="ReleaseListScrollBar" TargetType="ScrollBar">
            <Setter Property="Width" Value="8" />
            <Setter Property="MinWidth" Value="8" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Width="8" Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb Background="#80000000" Width="8">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="4" />
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ReleaseCellText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.Foreground}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <Style x:Key="ReleaseListItemStyle" TargetType="ListViewItem">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.Foreground}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <Border BorderBrush="{DynamicResource MaterialDesign.Brush.Separator.Background}"
                                BorderThickness="0,0,0,1"
                                Background="Transparent"
                                TextElement.Foreground="{TemplateBinding Foreground}">
                            <Grid>
                                <Border x:Name="HoverBackground"
                                        Background="{DynamicResource MaterialDesign.Brush.Primary}"
                                        Opacity="0" />
                                <ContentPresenter />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="HoverBackground" Property="Opacity" Value="0.12" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="HoverBackground" Property="Opacity" Value="0.22" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True" />
                                    <Condition Property="IsSelected" Value="True" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="HoverBackground" Property="Opacity" Value="0.30" />
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ReleaseListViewStyle" TargetType="ListView">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.Foreground}" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
            <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
            <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource ReleaseListItemStyle}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListView">
                        <Border Background="{TemplateBinding Background}"
                                BorderThickness="0">
                            <ScrollViewer x:Name="PART_ScrollViewer"
                                          Focusable="False"
                                          Padding="{TemplateBinding Padding}"
                                          HorizontalScrollBarVisibility="Disabled"
                                          VerticalScrollBarVisibility="Auto"
                                          CanContentScroll="{TemplateBinding ScrollViewer.CanContentScroll}">
                                <ScrollViewer.Template>
                                    <ControlTemplate TargetType="ScrollViewer">
                                        <Grid>
                                            <ScrollContentPresenter x:Name="PART_ScrollContentPresenter"
                                                                    CanContentScroll="{TemplateBinding CanContentScroll}" />
                                            <ScrollBar x:Name="PART_VerticalScrollBar"
                                                       Style="{StaticResource ReleaseListScrollBar}"
                                                       Orientation="Vertical"
                                                       HorizontalAlignment="Right"
                                                       VerticalAlignment="Stretch"
                                                       Margin="0,0,2,0"
                                                       Value="{TemplateBinding VerticalOffset}"
                                                       Maximum="{TemplateBinding ScrollableHeight}"
                                                       ViewportSize="{TemplateBinding ViewportHeight}"
                                                       Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}" />
                                        </Grid>
                                    </ControlTemplate>
                                </ScrollViewer.Template>
                                <ItemsPresenter />
                            </ScrollViewer>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="ReleaseItemTemplate">
            <Grid Margin="10,6,14,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="118" />
                    <ColumnDefinition Width="88" />
                    <ColumnDefinition Width="56" />
                    <ColumnDefinition Width="80" />
                    <ColumnDefinition Width="2*" MinWidth="120" />
                    <ColumnDefinition Width="2.4*" MinWidth="140" />
                    <ColumnDefinition Width="148" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Style="{StaticResource ReleaseCellText}"
                           FontFamily="Cascadia Mono, Consolas"
                           Text="{Binding VersionText}" />
                <TextBlock Grid.Column="1"
                           Style="{StaticResource ReleaseCellText}"
                           Text="{Binding PickText}"
                           Foreground="{DynamicResource MaterialDesign.Brush.Primary}" />
                <TextBlock Grid.Column="2"
                           Style="{StaticResource ReleaseCellText}"
                           Text="{Binding EnabledText}" />
                <TextBlock Grid.Column="3"
                           Style="{StaticResource ReleaseCellText}"
                           Text="{Binding MandatoryText}" />
                <TextBlock Grid.Column="4"
                           Style="{StaticResource ReleaseCellText}"
                           Text="{Binding DownloadUrl}"
                           ToolTip="{Binding DownloadUrl}" />
                <TextBlock Grid.Column="5"
                           Style="{StaticResource ReleaseCellText}"
                           Text="{Binding NotesPreview}"
                           ToolTip="{Binding NotesText}" />
                <TextBlock Grid.Column="6"
                           Style="{StaticResource ReleaseCellText}"
                           FontFamily="Cascadia Mono, Consolas"
                           Text="{Binding UpdatedAtText}" />
            </Grid>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:ConfirmPrompt}">
            <StackPanel Margin="24" MinWidth="320" MaxWidth="420">
                <DockPanel Margin="0,0,0,16">
                    <m3:PackIcon Kind="AlertOutline"
                                             Width="22"
                                             Height="22"
                                             VerticalAlignment="Center"
                                             Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                                             Margin="0,0,12,0" />
                    <TextBlock Text="{Binding Title}"
                               FontSize="16"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                </DockPanel>
                <TextBlock Text="{Binding Message}"
                           TextWrapping="Wrap"
                           Opacity="0.9" />
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Margin="0,28,0,0">
                    <Button Content="否"
                            Style="{StaticResource MaterialDesignFlatButton}"
                            Command="{x:Static m3:DialogHost.CloseDialogCommand}"
                            CommandParameter="False"
                            Margin="0,0,8,0"
                            IsCancel="True" />
                    <Button Content="是"
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            Command="{x:Static m3:DialogHost.CloseDialogCommand}"
                            CommandParameter="True"
                            IsDefault="True" />
                </StackPanel>
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <m3:DialogHost Identifier="RootDialog" DialogTheme="Inherit">
    <Grid>
    <m3:DrawerHost IsRightDrawerOpen="{Binding IsDrawerOpen, Mode=TwoWay}"
                               RightDrawerCloseOnClickAway="True"
                               OpenMode="Modal">
        <m3:DrawerHost.RightDrawerContent>
            <Border Width="420"
                    Background="{DynamicResource MaterialDesign.Brush.Card.Background}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Margin="24,24,24,20">
                        <TextBlock Text="{Binding EditorTitle}"
                                   FontSize="20"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="{Binding EditorMeta}"
                                   Margin="0,6,0,0"
                                   FontSize="12"
                                   Opacity="0.6"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <ScrollViewer Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="24,0"
                                    IsEnabled="{Binding IsEditing}">
                            <StackPanel Style="{StaticResource FieldGroup}">
                                <TextBlock Text="版本号" Style="{StaticResource FieldLabel}" />
                                <TextBox x:Name="VersionBox"
                                         Text="{Binding EditVersion, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource FieldBox}"
                                         FontFamily="Cascadia Mono, Consolas"
                                         m3:HintAssist.Hint="例如 2026.1.8.0" />
                            </StackPanel>

                            <StackPanel Style="{StaticResource FieldGroup}">
                                <TextBlock Text="发布状态" Style="{StaticResource FieldLabel}" />
                                <StackPanel Orientation="Horizontal">
                                    <CheckBox Content="启用"
                                              IsChecked="{Binding EditEnabled}"
                                              Margin="0,0,24,0" />
                                    <CheckBox Content="必须更新"
                                              IsChecked="{Binding EditMandatory}" />
                                </StackPanel>
                                <TextBlock Text="未启用的版本，QAdmin 不会读取。"
                                           Style="{StaticResource FieldHelp}" />
                            </StackPanel>

                            <StackPanel Style="{StaticResource FieldGroup}">
                                <TextBlock Text="下载地址" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding EditDownloadUrl, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource FieldBox}"
                                         m3:HintAssist.Hint="https://" />
                                <TextBlock Text="留空时，QAdmin 不显示下载入口。"
                                           Style="{StaticResource FieldHelp}" />
                            </StackPanel>

                            <StackPanel Style="{StaticResource FieldGroup}">
                                <TextBlock Text="更新说明" Style="{StaticResource FieldLabel}" />
                                <TextBox x:Name="NotesBox"
                                         Text="{Binding EditLines, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource FieldBox}"
                                         m3:HintAssist.Hint="每行一条"
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap"
                                         VerticalScrollBarVisibility="Auto"
                                         MinHeight="160"
                                         VerticalContentAlignment="Top" />
                                <TextBlock Text="QAdmin 按行显示。"
                                           Style="{StaticResource FieldHelp}" />
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <Border Grid.Row="2"
                            Padding="24,14">
                        <DockPanel LastChildFill="False">
                            <Button DockPanel.Dock="Left"
                                    Content="删除"
                                    Width="96"
                                    Command="{Binding DeleteCommand}"
                                    Style="{StaticResource PillButtonDanger}" />
                            <Button DockPanel.Dock="Right"
                                    Content="提交"
                                    Width="96"
                                    Command="{Binding SaveCommand}"
                                    Style="{StaticResource PillButton}" />
                        </DockPanel>
                    </Border>
                </Grid>
            </Border>
        </m3:DrawerHost.RightDrawerContent>

        <Grid Margin="20,20,20,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <DockPanel Margin="0,0,0,16">
                <TextBlock Text="版本记录"
                           FontSize="22"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center" />
                <TextBlock HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           Opacity="0.6"
                           Text="{Binding Releases.Count, StringFormat=共 {0} 条}" />
            </DockPanel>

            <m3:Card Grid.Row="1"
                                 UniformCornerRadius="8"
                                 Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0"
                            Padding="10,8,14,8"
                            BorderBrush="{DynamicResource MaterialDesign.Brush.Separator.Background}"
                            BorderThickness="0,0,0,1"
                            Background="{DynamicResource MaterialDesign.Brush.Card.Background}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="118" />
                                <ColumnDefinition Width="88" />
                                <ColumnDefinition Width="56" />
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="2*" MinWidth="120" />
                                <ColumnDefinition Width="2.4*" MinWidth="140" />
                                <ColumnDefinition Width="148" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="版本" FontWeight="SemiBold" Opacity="0.7" />
                            <TextBlock Grid.Column="1" Text="客户端" FontWeight="SemiBold" Opacity="0.7" />
                            <TextBlock Grid.Column="2" Text="启用" FontWeight="SemiBold" Opacity="0.7" />
                            <TextBlock Grid.Column="3" Text="必须更新" FontWeight="SemiBold" Opacity="0.7" />
                            <TextBlock Grid.Column="4" Text="下载地址" FontWeight="SemiBold" Opacity="0.7" />
                            <TextBlock Grid.Column="5" Text="更新说明" FontWeight="SemiBold" Opacity="0.7" />
                            <TextBlock Grid.Column="6" Text="更新时间" FontWeight="SemiBold" Opacity="0.7" />
                        </Grid>
                    </Border>
                    <ListView Grid.Row="1"
                              Style="{StaticResource ReleaseListViewStyle}"
                              ItemsSource="{Binding Releases}"
                              ItemTemplate="{StaticResource ReleaseItemTemplate}"
                              SelectedItem="{Binding SelectedRelease, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              SelectionMode="Single"
                              PreviewMouseLeftButtonUp="ReleaseList_OnPreviewMouseLeftButtonUp" />
                </Grid>
            </m3:Card>

            <TextBlock Grid.Row="2"
                       Text="{Binding StatusText}"
                       Margin="0,12,0,0"
                       TextWrapping="Wrap"
                       Opacity="0.8" />
        </Grid>
    </m3:DrawerHost>

        <Grid x:Name="LoadingOverlay"
              Panel.ZIndex="20"
              ClipToBounds="True">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsBusy}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Border Background="{DynamicResource MaterialDesignPaper}" />
            <Grid Width="278"
                  Height="236"
                  Margin="0,36,0,0"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Top"
                  ClipToBounds="True"
                  IsHitTestVisible="False">
                <lottie:LottieAnimationView x:Name="LoadingLottie"
                                            Width="278"
                                            Height="236"
                                            AutoPlay="True"
                                            RepeatCount="-1"
                                            HorizontalAlignment="Stretch"
                                            VerticalAlignment="Stretch" />
            </Grid>
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Margin="24"
                        MaxWidth="520"
                        IsHitTestVisible="False">
                <TextBlock Text="{Binding LoadingTitle}"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
                           HorizontalAlignment="Center"
                           TextAlignment="Center" />
                <ItemsControl ItemsSource="{Binding LoadingSteps}"
                              Margin="0,12,0,0"
                              HorizontalAlignment="Center"
                              Foreground="{DynamicResource MaterialDesign.Brush.Foreground}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}"
                                       FontSize="13"
                                       Opacity="0.75"
                                       Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"
                                       HorizontalAlignment="Center"
                                       Margin="0,3" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Grid>
    </Grid>
    </m3:DialogHost>
</Window>