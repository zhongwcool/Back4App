<Window x:Class="Versioner.Views.CredentialWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:m3="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="配置 Back4App"
        Width="440"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource MaterialDesignPaper}"
        FontFamily="{m3:MaterialDesignFont}"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        TextOptions.TextRenderingMode="Auto"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Window.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
    </Window.Resources>
    <Border Padding="24">
        <StackPanel>
            <TextBlock Text="配置 Back4App"
                       FontSize="20"
                       FontWeight="SemiBold"
                       Margin="0,0,0,20" />

            <StackPanel Margin="0,0,0,16">
                <TextBlock Text="Application Id" Style="{StaticResource FieldLabel}" />
                <TextBox x:Name="ApplicationIdBox"
                         Style="{StaticResource MaterialDesignFilledTextBox}"
                         PreviewMouseLeftButtonDown="Field_OnPreviewMouseLeftButtonDown"
                         PreviewMouseLeftButtonUp="Field_OnPreviewMouseLeftButtonUp"
                         GotKeyboardFocus="Field_OnGotKeyboardFocus" />
            </StackPanel>

            <StackPanel Margin="0,0,0,16">
                <TextBlock Text="Master Key" Style="{StaticResource FieldLabel}" />
                <PasswordBox x:Name="MasterKeyBox"
                             Style="{StaticResource MaterialDesignFilledRevealPasswordBox}"
                             PreviewMouseLeftButtonDown="Field_OnPreviewMouseLeftButtonDown"
                             PreviewMouseLeftButtonUp="Field_OnPreviewMouseLeftButtonUp"
                             GotKeyboardFocus="Field_OnGotKeyboardFocus" />
            </StackPanel>

            <StackPanel>
                <TextBlock Text="Server URL" Style="{StaticResource FieldLabel}" />
                <TextBox x:Name="ServerUrlBox"
                         Style="{StaticResource MaterialDesignFilledTextBox}"
                         PreviewMouseLeftButtonDown="Field_OnPreviewMouseLeftButtonDown"
                         PreviewMouseLeftButtonUp="Field_OnPreviewMouseLeftButtonUp"
                         GotKeyboardFocus="Field_OnGotKeyboardFocus" />
            </StackPanel>

            <TextBlock x:Name="ErrorText"
                       Margin="0,12,0,0"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource MaterialDesign.Brush.ValidationError}"
                       Visibility="Collapsed" />

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,24,0,0">
                <Button Content="取消"
                        IsCancel="True"
                        Style="{StaticResource MaterialDesignFlatButton}"
                        MinWidth="76"
                        Margin="0,0,8,0" />
                <Button Content="保存"
                        IsDefault="True"
                        Click="Save_OnClick"
                        Style="{StaticResource MaterialDesignRaisedButton}"
                        MinWidth="76" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
